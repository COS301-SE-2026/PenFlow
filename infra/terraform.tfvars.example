project_name = "penflow"
environment  = "production"
aws_region   = "af-south-1"

domain_name      = "example.com"
auth_domain_name = "auth.example.com"

db_name     = "penflow"
db_username = "penflow_administrator"

rabbitmq_username       = "penflow"
rabbitmq_engine_version = "<supported RabbitMQ version in your AWS region>"

app_env   = "production"
log_level = "INFO"

smtp_host = "smtp.example.com"
smtp_port = 587
smtp_user = "smtp-user"
smtp_from = "noreply@example.com"

email_from       = "notifications@example.com"
ses_identity_arn = "arn:aws:ses:af-south-1:123456789012:identity/example.com"

backend_desired_count      = 1
frontend_desired_count     = 1
worker_desired_count       = 1
email_worker_desired_count = 1
keycloak_desired_count     = 1
schedule_worker_desired_count = 1
celery_beat_desired_count     = 1

# Secret values are not stored here. They are supplied to scripts/bootstrap-infra.sh through environment variables.
