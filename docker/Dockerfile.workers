FROM python:3.12-slim AS deps

WORKDIR /app

ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1

COPY workers/requirements.txt ./requirements.txt

RUN apt-get update && \
    apt-get upgrade -y && \
    apt-get install -y --no-install-recommends \
    nmap \
    libpango-1.0-0 \
    libpangoft2-1.0-0 \
    libharfbuzz0b \
    libharfbuzz-subset0 \
    libffi-dev \
    libjpeg62-turbo \
    libopenjp2-7 \
    libglib2.0-0 \
    fonts-dejavu-core \
    && rm -rf /var/lib/apt/lists/*

RUN --mount=type=cache,target=/root/.cache/pip \
    pip install --upgrade pip uv

RUN --mount=type=cache,target=/root/.cache/uv \
    uv pip install --system \
    -r requirements.txt

COPY scripts/patch-wappalyzer.py /tmp/patch-wappalyzer.py
RUN python /tmp/patch-wappalyzer.py

FROM python:3.12-slim AS runner

WORKDIR /app

ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1

RUN apt-get update && \
    apt-get upgrade -y && \
    apt-get install -y --no-install-recommends \
    nmap \
    ca-certificates \
    libpango-1.0-0 \
    libpangoft2-1.0-0 \
    libharfbuzz0b \
    libharfbuzz-subset0 \
    libffi-dev \
    libjpeg62-turbo \
    libopenjp2-7 \
    libglib2.0-0 \
    fonts-dejavu-core \
    && rm -rf /var/lib/apt/lists/*

COPY --from=deps /usr/local /usr/local
RUN python -m pip uninstall -y uv pip && \
    rm -rf /usr/local/lib/python3.12/site-packages/pip
COPY workers/app ./app
COPY workers/docs ./docs

RUN adduser --disabled-password --gecos "" appuser && \
    mkdir -p /app/generated_reports && \
    chown -R appuser:appuser /app

COPY docker/certs/rds-global-bundle.pem /app/certs/rds-global-bundle.pem
COPY --chmod=0644 docker/certs/penflow-internal-ca.pem \
    /app/certs/penflow-internal-ca.pem
    
USER appuser

CMD ["celery", "-A", "app.queue.celery_app:celery_app", "worker", "--loglevel=info", "--concurrency=2"]