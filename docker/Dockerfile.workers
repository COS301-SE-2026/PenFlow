FROM python:3.12-alpine3.24 AS deps

WORKDIR /app

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

RUN apk upgrade --no-cache && \
    apk add --no-cache \
        build-base \
        postgresql-dev \
        libffi-dev \
        jpeg-dev \
        zlib-dev \
        openjpeg-dev \
        libxml2-dev \
        libxslt-dev

RUN pip install --no-cache-dir uv

COPY workers/requirements.txt ./requirements.txt

RUN uv venv /opt/venv && \
    uv pip install --python /opt/venv/bin/python -r requirements.txt

COPY scripts/patch-wappalyzer.py /tmp/patch-wappalyzer.py

RUN /opt/venv/bin/python /tmp/patch-wappalyzer.py


FROM python:3.12-alpine3.24 AS runner

WORKDIR /app

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PATH="/opt/venv/bin:$PATH"

RUN apk upgrade --no-cache && \
    apk add --no-cache \
        ca-certificates \
        pango \
        harfbuzz-subset \
        font-dejavu \
        libffi \
        libjpeg-turbo \
        openjpeg \
        libpq \
        libmagic \
        libxml2 \
        libxslt \
        nmap \
        nmap-scripts && \
    python -m pip uninstall -y pip

COPY --from=deps /opt/venv /opt/venv

COPY workers/app ./app
COPY workers/docs ./docs

RUN addgroup -g 1000 -S appuser && \
    adduser -u 1000 -S -G appuser appuser && \
    mkdir -p /app/generated_reports && \
    chown -R appuser:appuser /app

COPY docker/certs/rds-global-bundle.pem /app/certs/rds-global-bundle.pem

COPY --chmod=0644 docker/certs/penflow-internal-ca.pem \
    /app/certs/penflow-internal-ca.pem

USER appuser

CMD ["celery", "-A", "app.queue.celery_app:celery_app", "worker", "--loglevel=info", "--concurrency=2"]