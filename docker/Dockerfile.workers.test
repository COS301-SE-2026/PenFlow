FROM python:3.12-slim AS test

WORKDIR /app

ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1

RUN apt-get update && apt-get install -y --no-install-recommends \
    libpango-1.0-0 \
    libpangoft2-1.0-0 \
    libharfbuzz0b \
    libffi-dev \
    libjpeg62-turbo \
    libopenjp2-7 \
    libgdk-pixbuf-2.0-0 \
    libglib2.0-0 \
    shared-mime-info \
    fonts-dejavu-core \
    && rm -rf /var/lib/apt/lists/*

COPY workers/requirements.txt ./requirements.txt
COPY workers/requirements-dev.txt ./requirements-dev.txt

RUN --mount=type=cache,target=/root/.cache/pip \
    pip install --upgrade pip uv

RUN --mount=type=cache,target=/root/.cache/uv \
    uv pip install --system \
    -r requirements.txt \
    -r requirements-dev.txt

COPY workers/app ./app
COPY workers/tests ./tests
COPY workers/pytest.ini ./pytest.ini

RUN adduser --disabled-password --gecos "" appuser && \
    mkdir -p /app/generated_reports && \
    chown -R appuser:appuser /app

USER appuser

CMD ["pytest", "tests/integration"]