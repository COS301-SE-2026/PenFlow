FROM python:3.12-slim AS test

WORKDIR /app

ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1
ENV TEST_RDS_CA_FILE=/app/certs/rds-global-bundle.pem

RUN apt-get update && apt-get install -y --no-install-recommends \
    libpango-1.0-0 \
    libpangoft2-1.0-0 \
    libharfbuzz0b \
    libffi-dev \
    libjpeg62-turbo \
    libopenjp2-7 \
    libgdk-pixbuf-2.0-0 \
    libglib2.0-0 \
    shared-mime-info \
    fonts-dejavu-core \
    && rm -rf /var/lib/apt/lists/*

COPY workers/requirements.txt ./requirements.txt
COPY workers/requirements-dev.txt ./requirements-dev.txt

RUN --mount=type=cache,target=/root/.cache/pip \
    pip install --upgrade pip uv

RUN --mount=type=cache,target=/root/.cache/uv \
    uv pip install --system \
    -r requirements.txt \
    -r requirements-dev.txt

COPY scripts/patch-wappalyzer.py /tmp/patch-wappalyzer.py
RUN python /tmp/patch-wappalyzer.py

COPY workers/app ./app
COPY workers/tests ./tests
COPY workers/pytest.ini ./pytest.ini
COPY workers/docs ./docs
COPY backend/app/templates ./report-fixtures/templates
COPY backend/app/utils/report_context.py \
     backend/app/utils/phase2_report_context.py \
     ./report-fixtures/utils/

ENV REPORT_TEST_FIXTURES=/app/report-fixtures

RUN adduser --disabled-password --gecos "" appuser && \
    mkdir -p /app/generated_reports && \
    chown -R appuser:appuser /app

COPY docker/certs/rds-global-bundle.pem /app/certs/rds-global-bundle.pem
COPY --chmod=0644 docker/certs/penflow-internal-ca.pem \
    /app/certs/penflow-internal-ca.pem
    
USER appuser

CMD ["pytest", "tests/integration"]