FROM python:3.12-slim AS test

WORKDIR /app

ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1
ENV TEST_RDS_CA_FILE=/app/certs/rds-global-bundle.pem

RUN apt-get update && apt-get install -y --no-install-recommends \
    libmagic1 \
    libpango-1.0-0 \
    libpangoft2-1.0-0 \
    libharfbuzz0b \
    libffi-dev \
    libjpeg62-turbo \
    libopenjp2-7 \
    libgdk-pixbuf-2.0-0 \
    libglib2.0-0 \
    shared-mime-info \
    fonts-dejavu-core \
    && rm -rf /var/lib/apt/lists/*

COPY backend/requirements.txt ./requirements.txt
COPY backend/requirements-dev.txt ./requirements-dev.txt

RUN --mount=type=cache,target=/root/.cache/pip \
    pip install --upgrade pip uv

RUN --mount=type=cache,target=/root/.cache/uv \
    uv pip install --system \
    -r requirements.txt \
    -r requirements-dev.txt

COPY backend/app ./app
COPY backend/tests ./tests
COPY backend/scripts ./scripts
COPY backend/pytest.ini ./pytest.ini

RUN adduser --disabled-password --gecos "" appuser && \
    mkdir -p /app/generated_reports && \
    chown -R appuser:appuser /app

COPY docker/certs/rds-global-bundle.pem /app/certs/rds-global-bundle.pem
COPY --chmod=0644 docker/certs/penflow-internal-ca.pem \
    /app/certs/penflow-internal-ca.pem
    
USER appuser

CMD ["pytest", "tests/integration"]