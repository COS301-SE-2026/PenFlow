{
  "realm": "penflow",
  "enabled": true,

  "accessTokenLifespan": 900,
  "ssoSessionIdleTimeout": 1800,
  "ssoSessionMaxLifespan": 36000,
  "registrationAllowed": true,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "verifyEmail": true,
  "resetPasswordAllowed": true,
  "loginTheme": "penflow",
  "bruteForceProtected": true,
  "permanentLockout": false,
  "failureFactor": 5,
  "waitIncrementSeconds": 60,
  "maxFailureWaitSeconds": 900,
  "maxDeltaTimeSeconds": 43200,
  "quickLoginCheckMilliSeconds": 1000,
  "minimumQuickLoginWaitSeconds": 60,

  "browserFlow": "penflow-browser-mfa",
  "resetCredentialsFlow": "penflow-reset-credentials",
  "authenticationFlows": [
    {
      "alias": "penflow-browser-mfa",
      "description": "Browser login with mandatory password and OTP",
      "providerId": "basic-flow",
      "topLevel": true,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "authenticator": "auth-cookie",
          "authenticatorFlow": false,
          "requirement": "ALTERNATIVE",
          "priority": 10,
          "userSetupAllowed": false
        },
        {
          "authenticatorFlow": true,
          "flowAlias": "penflow-password-otp",
          "requirement": "ALTERNATIVE",
          "priority": 20,
          "userSetupAllowed": false
        }
      ]
    },
    {
      "alias": "penflow-reset-credentials",
      "description": "Reset password without resetting the OTP credential",
      "providerId": "basic-flow",
      "topLevel": true,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "authenticator": "reset-credentials-choose-user",
          "authenticatorFlow": false,
          "requirement": "REQUIRED",
          "priority": 10,
          "userSetupAllowed": false
        },
        {
          "authenticator": "reset-credential-email",
          "authenticatorFlow": false,
          "requirement": "REQUIRED",
          "priority": 20,
          "userSetupAllowed": false
        },
        {
          "authenticator": "reset-password",
          "authenticatorFlow": false,
          "requirement": "REQUIRED",
          "priority": 30,
          "userSetupAllowed": false
        }
      ]
    },
    {
      "alias": "penflow-password-otp",
      "description": "Require password and an authenticator code",
      "providerId": "basic-flow",
      "topLevel": false,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "authenticator": "auth-username-password-form",
          "authenticatorFlow": false,
          "requirement": "REQUIRED",
          "priority": 10,
          "userSetupAllowed": false
        },
        {
          "authenticator": "auth-otp-form",
          "authenticatorFlow": false,
          "requirement": "REQUIRED",
          "priority": 20,
          "userSetupAllowed": false
        }
      ]
    }
  ],

  "clientScopeMappings": {
    "realm-management": [
      {
        "client": "penflow-user-provisioner",
        "roles": [
          "manage-users",
          "view-users",
          "query-users",
          "view-realm"
        ]
      }
    ]
  },

  "requiredActions": [
    {
      "alias": "UPDATE_PASSWORD",
      "name": "Update Password",
      "providerId": "UPDATE_PASSWORD",
      "enabled": true,
      "defaultAction": false,
      "priority": 10,
      "config": {}
    },
    {
      "alias": "VERIFY_EMAIL",
      "name": "Verify Email",
      "providerId": "VERIFY_EMAIL",
      "enabled": true,
      "defaultAction": false,
      "priority": 20,
      "config": {}
    },
    {
      "alias": "CONFIGURE_TOTP",
      "name": "Configure OTP",
      "providerId": "CONFIGURE_TOTP",
      "enabled": true,
      "defaultAction": true,
      "priority": 30,
      "config": {}
    }
  ],

  "roles": {
    "realm": [
      {
        "name": "client",
        "description": "Standard PenFlow client"
      },
      {
        "name": "pentester",
        "description": "PenFlow penetration tester"
      },
      {
        "name": "service_delivery",
        "description": "Penflow service delivery"
      }
    ]
  },

  "defaultRoles": [
    "user"
  ],

  "clients": [
    {
      "clientId": "penflow-web",
      "name": "PenFlow Web",
      "enabled": true,

      "protocol": "openid-connect",
      "publicClient": true,

      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,

      "rootUrl": "https://pen-flow.com",
      "baseUrl": "https://pen-flow.com",

      "redirectUris": [
        "https://pen-flow.com/*"
      ],

      "webOrigins": [
        "https://pen-flow.com"
      ],

      "attributes": {
        "post.logout.redirect.uris": "https://pen-flow.com/*",
        "pkce.code.challenge.method": "S256"
      },

      "protocolMappers": [
        {
          "name": "penflow-api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "penflow-api",
            "id.token.claim": "false",
            "access.token.claim": "true",
            "introspection.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "penflow-api",
      "name": "PenFlow API",
      "enabled": true,

      "protocol": "openid-connect",
      "publicClient": false,

      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false
    },
    {
    "clientId": "penflow-user-provisioner",
    "name": "PenFlow User Provisioner",
    "enabled": true,

    "protocol": "openid-connect",
    "publicClient": false,
    "clientAuthenticatorType": "client-secret",
    "secret": "${KEYCLOAK_PROVISIONER_CLIENT_SECRET}",

    "standardFlowEnabled": false,
    "implicitFlowEnabled": false,
    "directAccessGrantsEnabled": false,
    "serviceAccountsEnabled": true,
    "fullScopeAllowed": false
  }
  ],

  "users": [
    {
      "username": "service-account-penflow-user-provisioner",
      "enabled": true,
      "serviceAccountClientId": "penflow-user-provisioner",
      "clientRoles": {
        "realm-management": [
          "manage-users",
          "view-users",
          "query-users",
          "view-realm"
        ]
      }
    }
  ]
}
